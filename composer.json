{
    "name": "littlecubiclegames/quests",
    "description": "Quest Component",
    "type": "library",
    "require": {
        "php": "^7.2||^8",
        "symfony/workflow": "^5.4 || ^6.4 || ^7.4 || ^8.0",
        "doctrine/orm": "^2.5 || ^3.0",
        "symfony/console": "^5.4 || ^6.4 || ^7.4 || ^8.0"
    },
    "repositories": [
        {"type": "vcs", "url": "https://github.com/etoa/Silex"}
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Stephan Vock",
            "email": "stephan.vock@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "LittleCubicleGames\\Quests\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LittleCubicleGames\\Tests\\Quests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0",
        "friendsofphp/php-cs-fixer": "^3.0",
        "silex/silex": "dev-master",
        "phpstan/phpstan": "^1",
        "phpstan/phpstan-strict-rules": "^1",
        "phpstan/phpstan-phpunit": "^1",
        "phpstan/phpstan-deprecation-rules": "^1"
    }
}
